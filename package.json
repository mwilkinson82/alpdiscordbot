{
  "name": "alpdiscordbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ALP Contractor Circle Discord community bot.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "register:commands": "tsx scripts/register-commands.ts",
    "setup:env": "tsx scripts/setup-env.ts"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "node-cron": "^4.5.0",
    "openai": "^6.45.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": "^6.27.0"
  },
  "engines": {
    "node": ">=22"
  }
}
