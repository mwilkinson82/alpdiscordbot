# Required Discord bot settings
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=927273292354711613

# Default IDs recovered from the old Manus bot.
DISCORD_GENERAL_CHANNEL_ID=1484648401483206739
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=1484648401483206739
DISCORD_OWNER_USER_IDS=927272166049865807
CONTRACTOR_CIRCLE_ROLE_IDS=1484648318662344985
CONTRACTOR_CIRCLE_ROLE_NAMES=Contractor Circle,Contractor Circle Member,Member

# Required for AI-generated call recaps and prompts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low

# HTTP server for call recap webhooks.
PORT=8787
WEBHOOK_SECRET=change-me

# Stripe webhook for Contractor Circle purchases (ALPio live account only).
# Create the endpoint in the ALPio Stripe Dashboard, not Overwatch.
# URL: https://<bot-host>/webhooks/stripe
# Events: checkout.session.completed (optionally customer.subscription.created)
STRIPE_WEBHOOK_SECRET=
# Optional. Needed to retrieve Checkout line items when the event payload omits them.
STRIPE_SECRET_KEY=
# Prefer a specific Circle price and/or product ID. Comma-separated IDs are allowed.
# Do not match by amount. Intensives and other ALPio products are ignored.
STRIPE_CONTRACTOR_CIRCLE_PRICE_ID=
STRIPE_CONTRACTOR_CIRCLE_PRODUCT_ID=

# Scheduling. The timezone should match where you want the community cadence anchored.
TIMEZONE=America/New_York
MORNING_POST_HOUR=8
DAYTIME_PROMPT_HOURS=10,13,16
ENABLE_WEEKEND_POSTS=false
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=true
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=false
SCHEDULED_PROMPTS_USE_AI=true
ASSISTANT_REPLIES_ENABLED=true
ASSISTANT_REPLY_COOLDOWN_SECONDS=20
ASSISTANT_CONTEXTUAL_REPLIES_ENABLED=true
ASSISTANT_CONTEXTUAL_REPLY_WINDOW_MINUTES=180
ASSISTANT_CONTEXTUAL_REPLY_MAX_PER_POST=3
TARGETED_PROMPT_RESPONSE_HOURS=24

# Optional persistence and tuning.
DATA_DIR=./data
WELCOME_DEDUP_MINUTES=5
RECENT_ACTIVITY_LOOKBACK_MINUTES=180
MIN_MINUTES_BETWEEN_AUTO_PROMPTS=90
LOG_LEVEL=info
